# ai-free-swap configuration
# API keys can use ${ENV_VAR} syntax for environment variable expansion
#
# All providers use their OpenAI-compatible endpoints (base_url is preset).
# Only Anthropic uses its native API. Custom base_url overrides the preset.

keep_cycles: 1  # How many full cycles through all priorities before returning failure
model_name: "aifree"  # Name returned by /v1/models and used as the default model alias
show_provider: true  # Include provider_name in API responses
model_routing: "any"  # "any" = ignore client model, "match" = route by model name

server:
  host: "0.0.0.0"
  port: 8000
  api_key: ""  # Optional: set to require Bearer token auth on the proxy

providers:
  # Priority 1: tried first, backends within a group are tried in random order
  - priority: 1
    backends:
      - provider: gemini
        name: "gemini-flash-1"
        api_key: "${GEMINI_API_KEY_1}"
        model: "gemini-2.5-flash"
        # limits:          # Optional: rate limits to stay within free tier
        #   rpm: 15        # requests per minute
        #   rph: 500       # requests per hour
        #   rpd: 1500      # requests per day
        #   tpm: 1000000   # tokens per minute
        #   tpd: 50000000  # tokens per day
      - provider: gemini
        name: "gemini-flash-2"
        api_key: "${GEMINI_API_KEY_2}"
        model: "gemini-2.5-flash"
      - provider: gemini
        api_key: "${GEMINI_API_KEY_3}"
        model: "gemini-2.5-flash-lite"

  # Priority 2: tried if all priority 1 backends fail
  - priority: 2
    backends:
      - provider: qwen
        api_key: "${DASHSCOPE_API_KEY}"
        model: "qwen-flash"
        # Use provider: qwen-cn instead for China-region DashScope keys.

  # Priority 3
  - priority: 3
    backends:
      - provider: openrouter
        api_key: "${OPENROUTER_API_KEY}"
        model: "google/gemini-2.5-flash:free"
      - provider: openrouter
        api_key: "${OPENROUTER_API_KEY}"
        model: "meta-llama/llama-4-scout:free"

  # Priority 4: Grok (xAI)
  - priority: 4
    backends:
      - provider: grok
        api_key: "${XAI_API_KEY}"
        model: "grok-3-mini"

  # Priority 5: Anthropic (uses native API, not OpenAI-compatible)
  - priority: 5
    backends:
      - provider: anthropic
        api_key: "${ANTHROPIC_API_KEY}"
        model: "claude-sonnet-4-6"

  # # Priority 6: DeepSeek has a built-in OpenAI-compatible base URL.
  # - priority: 6
  #   backends:
  #     - provider: deepseek
  #       api_key: "${DEEPSEEK_API_KEY}"
  #       model: "deepseek-chat"

  # # Any OpenAI-compatible provider — just set base_url.
  # # The provider name can be anything (used for logging).
  # - priority: 7
  #   backends:
  #     - provider: groq
  #       api_key: "${GROQ_API_KEY}"
  #       model: "llama-3.3-70b-versatile"
  #       base_url: "https://api.groq.com/openai/v1"
  #     - provider: together
  #       api_key: "${TOGETHER_API_KEY}"
  #       model: "meta-llama/Llama-3.3-70B-Instruct-Turbo"
  #       base_url: "https://api.together.xyz/v1"
  #     - provider: ollama
  #       api_key: "unused"
  #       model: "llama3.2"
  #       base_url: "http://localhost:11434/v1"
